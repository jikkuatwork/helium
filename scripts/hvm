#!/usr/bin/env bash
#
# hvm — on-demand remote worker VMs for Pi/harnex lanes (koder plan 38).
#
# Provision a sponsored Azure VM, bootstrap it to toolchain parity with this
# machine, push a repo to it, run harnex lanes there, and pull finished lanes
# back as local worktrees.
#
# Usage: scripts/hvm <command> [args]
#
#   up NAME [--size SKU] [--region R] [--image URN] [--disk GB]
#                         provision (runs cloma's sponsored-credit guard first)
#   init NAME             bootstrap: mise ruby/node/go, pi, harnex, pi-config
#   key NAME              install the host's Foundry key (read from stdin)
#   push NAME [DIR]       push DIR's repo (default: cwd) to ~/work/<repo>
#   delegate NAME LANE BRIEF [harnex opts]
#                         copy BRIEF to the host, start a worktree lane there
#   run NAME CMD...       run CMD in the host's repo dir (e.g. harnex lanes)
#   fetch NAME LANE [DIR] fetch harnex/LANE into a local worktree for review
#   land NAME LANE [DIR]  merge harnex/LANE locally, clean up both sides, re-push
#   ssh NAME [CMD...]     ssh to the host
#   status [NAME]         power state, size, IP of one or all hosts
#   allow-me NAME         point the SSH rule at this machine's current IP
#   stop NAME | start NAME   deallocate / start
#   destroy NAME [--yes]  delete the host's resource group and local records
#
# Private state (never in a repo): ~/.config/hvm/
#   hosts/NAME.env   resource names, IP, size;  ssh_config   Host blocks
#
# Environment:
#   HVM_REGION (westus2)  HVM_SIZE (Standard_D32ps_v5)  HVM_DISK_GB (256)
#   HVM_CLOMA_DIR (~/Projects/cloma)  HVM_PI_CONFIG (~/Projects/pi-config)
#   HVM_SKIP_GUARD=1 only to re-run `up` steps after a passed guard

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HVM_HOME="${HVM_HOME:-$HOME/.config/hvm}"
HOSTS_DIR="$HVM_HOME/hosts"
SSH_CFG="$HVM_HOME/ssh_config"
SSH_KEY="${HVM_SSH_KEY:-$HOME/.ssh/hvm_ed25519}"
REGION="${HVM_REGION:-westus2}"  # eastus2: every ARM size is NotAvailableForSubscription (2026-11-04)
SIZE="${HVM_SIZE:-Standard_D32ps_v5}"
DISK_GB="${HVM_DISK_GB:-256}"
CLOMA_DIR="${HVM_CLOMA_DIR:-$HOME/Projects/cloma}"
PI_CONFIG="${HVM_PI_CONFIG:-$HOME/Projects/pi-config}"
ADMIN_USER="hvm"

say()  { printf '\033[1;34m[hvm]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[hvm]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[hvm]\033[0m %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }

# ── host registry ────────────────────────────────────────────────────────────

host_file() { echo "$HOSTS_DIR/$1.env"; }
alias_of()  { echo "hvm-$1"; }

load_host() {
  local f; f="$(host_file "$1")"
  [ -f "$f" ] || die "no host '$1' (see: scripts/hvm status)"
  # shellcheck disable=SC1090
  . "$f"
}

save_host() { # NAME then KEY=VALUE pairs
  local name="$1"; shift
  mkdir -p "$HOSTS_DIR"; chmod 700 "$HVM_HOME"
  : > "$(host_file "$name")"
  for kv in "$@"; do printf '%s\n' "${kv%%=*}=$(printf '%q' "${kv#*=}")" >> "$(host_file "$name")"; done
}

ensure_ssh_include() {
  mkdir -p "$HOME/.ssh" "$HVM_HOME"; chmod 700 "$HOME/.ssh" "$HVM_HOME"
  touch "$SSH_CFG" "$HOME/.ssh/config"; chmod 600 "$SSH_CFG" "$HOME/.ssh/config"
  if ! grep -qF "Include $SSH_CFG" "$HOME/.ssh/config"; then
    local tmp; tmp="$(mktemp)"
    { printf 'Include %s\n\n' "$SSH_CFG"; cat "$HOME/.ssh/config"; } > "$tmp"
    cat "$tmp" > "$HOME/.ssh/config"; rm -f "$tmp"
    say "added 'Include $SSH_CFG' to ~/.ssh/config"
  fi
}

write_ssh_block() { # NAME IP
  local a; a="$(alias_of "$1")"
  remove_ssh_block "$1"
  cat >> "$SSH_CFG" <<EOF
# hvm:$1
Host $a
  HostName $2
  User $ADMIN_USER
  IdentityFile $SSH_KEY
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile $HVM_HOME/known_hosts
  ServerAliveInterval 30
  ServerAliveCountMax 6
  ControlMaster auto
  ControlPath $HVM_HOME/cm-%r@%h:%p
  ControlPersist 10m
# /hvm:$1
EOF
}

remove_ssh_block() {
  [ -f "$SSH_CFG" ] || return 0
  local tmp; tmp="$(mktemp)"
  awk -v s="# hvm:$1" -v e="# /hvm:$1" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$SSH_CFG" > "$tmp"
  cat "$tmp" > "$SSH_CFG"; rm -f "$tmp"
}

hssh() { local n="$1"; shift; ssh "$(alias_of "$n")" "$@"; }

# harnex 0.30.1 picks tmux new-window vs new-session by $TMUX alone. Over
# non-interactive ssh $TMUX is unset, so every lane after the first dies with
# "duplicate session: harnex". Point TMUX at the host's live session first.
REMOTE_TMUX_ENV='if [ -z "${TMUX:-}" ] && tmux has-session -t =harnex 2>/dev/null; then TMUX="$(tmux display -p -t =harnex "#{socket_path},#{pid},#{session_id}" | tr -d "$")"; export TMUX; fi;'

egress_ip() {
  local ip; ip="$(curl -fsS --max-time 10 https://api.ipify.org || true)"
  [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "could not determine this machine's public IP"
  echo "$ip"
}

repo_root() { git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null || die "not a git repo: ${1:-.}"; }

# ── guard (cloma) ────────────────────────────────────────────────────────────

sponsored_guard() {
  if [ "${HVM_SKIP_GUARD:-}" = "1" ]; then warn "HVM_SKIP_GUARD=1: skipping sponsored guard"; return; fi
  [ -d "$CLOMA_DIR" ] || die "cloma not found at $CLOMA_DIR (sponsored guard is mandatory)"
  say "sponsored-credit guard (cloma verify-sponsored --no-cache)…"
  local out
  out="$(cd "$CLOMA_DIR" && ruby bin/cloma verify-sponsored --json --no-cache 2>/dev/null)" \
    || die "sponsored guard FAILED or errored; refusing to create resources"
  printf '%s' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
status = str(d.get("status", "")).lower()
fails = d.get("failures") or []
if status != "pass" or fails:
    print(f"guard status={status!r} failures={len(fails)}", file=sys.stderr); sys.exit(1)
' || die "sponsored guard did not pass; refusing to create resources"
  say "guard: PASS"
}

cloma_log() { # private, append-only
  local log="$HOME/.cloma/CHANGELOG.md"
  [ -f "$log" ] || return 0
  printf '\n- %s hvm: %s\n' "$(date -u +%Y-%m-%dT%H:%MZ)" "$*" >> "$log"
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_up() {
  local name="${1:-}"; [ -n "$name" ] || usage 2; shift
  local image=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) SIZE="$2"; shift 2 ;;
      --region) REGION="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --disk) DISK_GB="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,20}$ ]] || die "NAME must be lowercase letters, digits, dashes (≤21)"
  [ -f "$(host_file "$name")" ] && die "host '$name' already exists (status / destroy it first)"
  need az; need ssh; need python3; need curl

  local arch=x64; [[ "$SIZE" =~ ^Standard_[A-Z]+[0-9]+[a-z]*p ]] && arch=arm64
  # `|| true`: under set -e a false test inside $(...) kills the script on x64
  [ -n "$image" ] || image="Canonical:ubuntu-24_04-lts:server$([ "$arch" = arm64 ] && echo -arm64 || true):latest"

  sponsored_guard

  say "image $image must carry no Marketplace plan…"
  local plan
  plan="$(az vm image show --urn "$image" -l "$REGION" --query plan -o tsv 2>/dev/null || echo ERR)"
  [ -z "$plan" ] || die "image has a plan or could not be read ($plan); refusing"

  [ -f "$SSH_KEY" ] || { say "creating $SSH_KEY"; ssh-keygen -q -t ed25519 -N '' -C "hvm@$(hostname)" -f "$SSH_KEY"; }
  ensure_ssh_include

  local rg="rg-hvm-$name" vm="hvm-$name" ip
  ip="$(egress_ip)"
  local tags=(cloma-approved=true purpose=remote-worker project="$name" created="$(date -u +%F)" managed-by=hvm)

  say "resource group $rg ($REGION)…"
  az group create -n "$rg" -l "$REGION" --tags "${tags[@]}" -o none
  cloma_log "up $name — RG $rg, VM $vm, $SIZE, $REGION (remote worker, helium plan 38)"

  say "VM $vm ($SIZE, $arch, ${DISK_GB} GB)… (a few minutes)"
  local pub
  pub="$(az vm create -g "$rg" -n "$vm" -l "$REGION" \
      --image "$image" --size "$SIZE" \
      --admin-username "$ADMIN_USER" --ssh-key-values "$SSH_KEY.pub" \
      --os-disk-size-gb "$DISK_GB" --storage-sku Premium_LRS \
      --public-ip-sku Standard --nsg-rule NONE --security-type Standard \
      --tags "${tags[@]}" --query publicIpAddress -o tsv)"
  [ -n "$pub" ] || die "VM created without a public IP?"

  say "SSH rule: only from $ip"
  az network nsg rule create -g "$rg" --nsg-name "${vm}NSG" -n ssh-operator \
    --priority 1000 --direction Inbound --access Allow --protocol Tcp \
    --source-address-prefixes "$ip/32" --destination-port-ranges 22 -o none

  save_host "$name" RG="$rg" VM="$vm" REGION="$REGION" SIZE="$SIZE" ARCH="$arch" \
    IP="$pub" OPERATOR_IP="$ip" IMAGE="$image" CREATED="$(date -u +%FT%TZ)"
  write_ssh_block "$name" "$pub"

  say "waiting for ssh…"
  local i; for i in $(seq 1 60); do
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$(alias_of "$name")" true 2>/dev/null && break
    sleep 5
  done
  hssh "$name" true || die "ssh did not come up; try: scripts/hvm ssh $name"
  say "up: $(alias_of "$name") ($pub). Next: scripts/hvm init $name"
}

cmd_init() {
  local name="${1:-}"; [ -n "$name" ] || usage 2
  load_host "$name"
  local pi_v harnex_v ruby_v node_v go_v gname gemail
  pi_v="$(pi --version 2>/dev/null | tail -1)"; [ -n "$pi_v" ] || die "local pi not found"
  harnex_v="$(harnex --version | awk '{print $2}')"
  ruby_v="$(awk '$1=="ruby"{print $2}' ~/.tool-versions)"
  node_v="$(node --version | sed 's/^v//')"
  go_v="$(go env GOVERSION | sed 's/^go//')"
  gname="$(git config --global user.name || true)"; gemail="$(git config --global user.email || true)"
  say "parity: pi $pi_v · harnex $harnex_v · ruby $ruby_v · node $node_v · go $go_v"

  if [ -d "$PI_CONFIG" ]; then
    say "syncing pi-config…"
    hssh "$name" mkdir -p src
    rsync -a --delete --exclude node_modules --exclude 'koder/scratch' \
      -e ssh "$PI_CONFIG/" "$(alias_of "$name"):src/pi-config/"
  else
    warn "no pi-config at $PI_CONFIG; Pi will run with defaults"
  fi

  hssh "$name" env PI_VERSION="$pi_v" HARNEX_VERSION="$harnex_v" RUBY_VERSION_WANT="$ruby_v" \
    NODE_VERSION_WANT="$node_v" GO_VERSION_WANT="$go_v" \
    GIT_NAME="$(printf %q "$gname")" GIT_EMAIL="$(printf %q "$gemail")" \
    bash -s < "$SCRIPT_DIR/hvm-host-init.sh"
  say "init done. Next: scripts/hvm key $name   then   scripts/hvm push $name"
}

cmd_key() {
  local name="${1:-}"; [ -n "$name" ] || usage 2
  load_host "$name"
  local key
  if [ -t 0 ]; then read -r -s -p "Foundry key for $name (fnd_…): " key; echo >&2
  else read -r key; fi
  [[ "$key" =~ ^fnd_ ]] || die "expected a fnd_… key"
  # stdin, never argv: keeps it out of process lists and shell history
  printf 'export FOUNDRY_API_KEY=%q\n' "$key" | hssh "$name" \
    'umask 077; mkdir -p ~/.config/hvm; cat > ~/.config/hvm/env; chmod 600 ~/.config/hvm/env'
  say "key installed on $(alias_of "$name") (~/.config/hvm/env, 600)"
}

cmd_push() {
  local name="${1:-}"; [ -n "$name" ] || usage 2
  load_host "$name"
  local root repo branch remote
  root="$(repo_root "${2:-.}")"; repo="$(basename "$root")"
  branch="$(git -C "$root" symbolic-ref --short HEAD)"; remote="$(alias_of "$name")"
  hssh "$name" "set -e; mkdir -p ~/work/$repo; cd ~/work/$repo
    [ -d .git ] || git init -q -b $branch
    git config receive.denyCurrentBranch updateInstead
    grep -qxF .harnex/ .git/info/exclude 2>/dev/null || echo .harnex/ >> .git/info/exclude"
  git -C "$root" remote get-url "$remote" >/dev/null 2>&1 \
    || git -C "$root" remote add "$remote" "$remote:work/$repo"
  say "pushing $repo:$branch → $remote:~/work/$repo"
  git -C "$root" push -q "$remote" "$branch"
  if [ -x "$root/.harnex/host-init.sh" ]; then
    say "running $repo/.harnex/host-init.sh on the host"
    hssh "$name" "cd ~/work/$repo && ./.harnex/host-init.sh"
  fi
  say "pushed $(git -C "$root" rev-parse --short HEAD)"
}

cmd_run() {
  local name="${1:-}"; [ -n "$name" ] || usage 2; shift
  load_host "$name"
  local repo; repo="$(basename "$(repo_root .)")"
  hssh "$name" "$REMOTE_TMUX_ENV cd ~/work/$repo && $(printf '%q ' "$@")"
}

cmd_delegate() {
  local name="${1:-}" lane="${2:-}" brief="${3:-}"
  [ -n "$name" ] && [ -n "$lane" ] && [ -f "$brief" ] || usage 2
  shift 3
  load_host "$name"
  local repo; repo="$(basename "$(repo_root .)")"
  hssh "$name" "mkdir -p ~/work/$repo/.harnex/briefs"
  scp -q "$brief" "$(alias_of "$name"):work/$repo/.harnex/briefs/$lane.md"
  hssh "$name" "$REMOTE_TMUX_ENV cd ~/work/$repo && harnex delegate --no-wait --worktree $(printf %q "$lane") \
    --file .harnex/briefs/$lane.md $(printf '%q ' "$@")"
}

cmd_fetch() {
  local name="${1:-}" lane="${2:-}"; [ -n "$name" ] && [ -n "$lane" ] || usage 2
  load_host "$name"
  local root remote wt
  root="$(repo_root "${3:-.}")"; remote="$(alias_of "$name")"
  wt="$root/.harnex/worktrees/$lane"
  git -C "$root" fetch -q "$remote" "harnex/$lane"
  grep -qxF '.harnex/' "$(git -C "$root" rev-parse --git-common-dir)/info/exclude" 2>/dev/null \
    || echo '.harnex/' >> "$(git -C "$root" rev-parse --git-common-dir)/info/exclude"
  if [ -d "$wt" ]; then
    git -C "$wt" merge -q --ff-only FETCH_HEAD
  else
    git -C "$root" worktree add -q -B "harnex/$lane" "$wt" FETCH_HEAD
  fi
  local base; base="$(git -C "$root" symbolic-ref --short HEAD)"
  say "worktree: $wt (branch harnex/$lane)"
  git -C "$root" log --oneline "$base..harnex/$lane" | sed 's/^/  /' >&2
  git -C "$root" diff --stat "$base...harnex/$lane" | tail -n 15 >&2
}

cmd_land() {
  local name="${1:-}" lane="${2:-}"; [ -n "$name" ] && [ -n "$lane" ] || usage 2
  load_host "$name"
  local root repo remote wt branch
  root="$(repo_root "${3:-.}")"; repo="$(basename "$root")"; remote="$(alias_of "$name")"
  wt="$root/.harnex/worktrees/$lane"; branch="$(git -C "$root" symbolic-ref --short HEAD)"
  git -C "$root" rev-parse -q --verify "harnex/$lane" >/dev/null || cmd_fetch "$name" "$lane" "$root"
  [ -z "$(git -C "$root" status --porcelain --untracked-files=no)" ] || die "uncommitted changes in $root; commit or stash first"
  say "merging harnex/$lane into $branch"
  git -C "$root" merge --no-edit "harnex/$lane" || die "merge conflict: resolve, commit, then re-run land"
  [ -d "$wt" ] && git -C "$root" worktree remove "$wt"
  git -C "$root" branch -q -d "harnex/$lane"
  say "cleaning the host (harnex discard, else plain git)"
  hssh "$name" "cd ~/work/$repo && { harnex discard $(printf %q "$lane") >/dev/null 2>&1 || {
      git worktree remove --force .harnex/worktrees/$lane 2>/dev/null; git branch -D harnex/$lane 2>/dev/null; true; }; }"
  git -C "$root" push -q "$remote" "$branch"
  say "landed $lane; host main re-synced to $(git -C "$root" rev-parse --short HEAD)"
}

cmd_status() {
  need az
  local names=()
  if [ -n "${1:-}" ]; then names=("$1"); else
    for f in "$HOSTS_DIR"/*.env; do [ -e "$f" ] && names+=("$(basename "$f" .env)"); done
  fi
  [ ${#names[@]} -gt 0 ] || { say "no hosts"; return; }
  local n
  for n in "${names[@]}"; do
    ( load_host "$n"
      local power
      power="$(az vm get-instance-view -g "$RG" -n "$VM" \
        --query "instanceView.statuses[?starts_with(code,'PowerState/')].displayStatus | [0]" -o tsv 2>/dev/null || echo unknown)"
      printf '%-12s %-16s %-20s %-8s %s\n' "$n" "${power:-unknown}" "$SIZE" "$REGION" "$IP" )
  done
}

cmd_allow_me() {
  local name="${1:-}"; [ -n "$name" ] || usage 2
  load_host "$name"; local ip; ip="$(egress_ip)"
  az network nsg rule update -g "$RG" --nsg-name "${VM}NSG" -n ssh-operator \
    --source-address-prefixes "$ip/32" -o none
  sed -i "s/^OPERATOR_IP=.*/OPERATOR_IP=$ip/" "$(host_file "$name")"
  say "SSH now allowed from $ip"
}

cmd_stop()  { load_host "${1:?NAME}"; say "deallocating $VM"; az vm deallocate -g "$RG" -n "$VM" -o none; cloma_log "stop ${1} (deallocated)"; }

cmd_start() {
  load_host "${1:?NAME}"; say "starting $VM"
  az vm start -g "$RG" -n "$VM" -o none
  local pub; pub="$(az vm show -d -g "$RG" -n "$VM" --query publicIps -o tsv)"
  if [ -n "$pub" ] && [ "$pub" != "$IP" ]; then
    sed -i "s/^IP=.*/IP=$pub/" "$(host_file "$1")"; write_ssh_block "$1" "$pub"
  fi
  cloma_log "start ${1}"
  say "started ($pub)"
}

cmd_destroy() {
  local name="${1:-}"; [ -n "$name" ] || usage 2
  load_host "$name"
  if [ "${2:-}" != "--yes" ]; then
    read -r -p "Delete resource group $RG (VM, disk, IP)? Type the host name to confirm: " ans
    [ "$ans" = "$name" ] || die "aborted"
  fi
  say "deleting $RG (async)"
  az group delete -n "$RG" --yes --no-wait
  cloma_log "destroy $name — RG $RG deletion requested"
  remove_ssh_block "$name"
  rm -f "$(host_file "$name")"
  local root; if root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    git -C "$root" remote remove "$(alias_of "$name")" 2>/dev/null || true
  fi
  warn "revoke the host's Foundry key (foundry keys_revoke) if it is not reused"
}

# ── main ─────────────────────────────────────────────────────────────────────

cmd="${1:-}"; [ -n "$cmd" ] || usage 2; shift
case "$cmd" in
  up) cmd_up "$@" ;;
  init) cmd_init "$@" ;;
  key) cmd_key "$@" ;;
  push) cmd_push "$@" ;;
  run) cmd_run "$@" ;;
  delegate) cmd_delegate "$@" ;;
  fetch) cmd_fetch "$@" ;;
  land) cmd_land "$@" ;;
  ssh) n="${1:?NAME}"; shift; load_host "$n"; hssh "$n" "$@" ;;
  status|list) cmd_status "$@" ;;
  allow-me) cmd_allow_me "$@" ;;
  stop) cmd_stop "$@" ;;
  start) cmd_start "$@" ;;
  destroy) cmd_destroy "$@" ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown command: $cmd (scripts/hvm help)" ;;
esac
